# scenario: funded
# Lightning first: no address is allocated until the On-chain tab opens.
click Spending
click Receive
expect Create invoice
expect-absent bc1qdemo
type "Amount (BTC)" 0.001
type "Description (optional)" Coffee
click Create invoice
expect lnbc1000000n1pdemo
expect Expires in
expect Fees take about 50 sat of this amount.
shot invoice
type "Amount (BTC)" 0.002
expect-not lnbc1000000n1pdemo
click On-chain
expect bc1qdemo
expect Deposits of 10000 sat or less are not credited.
shot address
close-dialog
# Saving on a hardware wallet: the address cannot be checked on the device.
click Saving
click Receive
expect bc1qdemo
expect Coins received this way are marked unmixed
expect Your device cannot display this address.
shot saving-address
